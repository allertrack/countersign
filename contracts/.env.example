# Copy to .env and fill in. Never commit .env or paste keys anywhere else.
# Use a FRESH wallet that only ever holds testnet funds (cast wallet new).
PRIVATE_KEY=

# Public RPCs work for the testnet scripts. For scripts/local-e2e.sh use an ARCHIVE endpoint for Arbitrum Sepolia:
# public nodes prune state within minutes and anvil forks then fail with "historical state is not available".
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Optional: verify contracts on Etherscan and Arbiscan (Etherscan API v2 key works for both).
ETHERSCAN_API_KEY=

# Roles (default to the deployer on testnet; use multisigs in production).
GUARDIAN=
TREASURY=

# Countersign is required at or above this amount (wei). Default 1,000 CST.
THRESHOLD=1000000000000000000000
# Fee charged per Countersign-gated transfer, in USD cents, paid through CCIP into the resolver.
CCV_FEE_USD_CENTS=0

# Production identity (ignored when CRE_SIMULATION=true, which scripts/testnet-e2e.sh sets for the MockKeystoneForwarder).
CRE_WORKFLOW_OWNER=
CRE_WORKFLOW_NAME=countersign
